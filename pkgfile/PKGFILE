pkgname=voidbr-epoptes
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
pkgdesc='An opensource computer lab management and monitoring tool (com suporte a Wayland nos clientes: thumbshots e observar/assistir)'
replaces=(epoptes)
makedepends=(git python3-distutils-extra intltool patch)
url="https://github.com/voidlinuxbr/$pkgname"
source=(
	"git+${url}.git"
	"voidbr-epoptes-servidor.patch"
)
license=(GPL3)
arch=(any)
sha256sums=(
	'SKIP'
	'8977ba5c29a47b120e5a988ddfc2644a69570db0d438bbf015d82f9aa1176335'
)
depends=(gobject-introspection
	gtk+3
	iperf
	iproute2
	faketime
	libnotify
	librsvg
	notification-daemon
	openssl
	python3-cairo
	python3-dbus
	python3-gobject
	python3-netifaces
	python3-openssl
	python3-service_identity
	python3-Twisted
	socat
	tigervnc
	x11vnc
	xterm)
optdepends=('xfce4-notifyd: XFCE notification support')
backup=(/etc/default/epoptes)

prepare() {
	cd "${srcdir}/${pkgname}"
	# VoidBR patch: o client-functions e lido pelo epoptesd (aqui, no
	# servidor) e ENVIADO para cada cliente na hora da conexao - e o
	# proprio codigo confirma isso (twisted/plugins/epoptesd.py chama
	# filter_bash('/usr/share/epoptes/client-functions') uma unica vez,
	# na inicializacao do daemon). Por isso o patch de suporte a Wayland
	# tem que estar aqui, no pacote do servidor, e nao (so) no cliente:
	# - thumbshot(): remove o bypass que pulava thumbshots em Wayland.
	# - get_monitored()/get_assisted(): usam wayvnc + socat como
	#   "conexao reversa" quando $WAYLAND_DISPLAY esta definido no
	#   cliente (wayvnc so escuta, nao tem -connect_or_exit como o
	#   x11vnc; o socat faz a ponte). So funciona em Hyprland/Sway/
	#   wlroots do lado do cliente por enquanto.
	# Os binarios (grim, wayvnc, socat) rodam no CLIENTE, nao aqui -
	# esse pacote nao precisa deles como dependencia.
	# gui.py: fix Python 3.14 (modulo "pipes" removido, virou "shlex").
	patch -p1 < "${srcdir}/voidbr-epoptes-servidor.patch"
}

package() {
	local dirs=("usr" "etc" "opt")
	#   echo "DESTDIR=$DESTDIR"
	#   echo "pkgdir=$pkgdir"
	#   echo "srcdir=$srcdir"
	#   echo "_pkgsrc=$_pkgsrc"
	cd ${srcdir}/${pkgname}
	for dir in "${dirs[@]}"; do
		if [ -d "${_pkgsrc}/${dir}" ]; then
			cp -a "${_pkgsrc}/${dir}" "$DESTDIR/"
		fi
	done
}
pre_install() {
	log "Iniciando instalação"
}
post_install() {
  pkgname="epoptes"
  if ! getent group epoptes >/dev/null; then
    groupadd epoptes >/dev/null || true
    echo "Group 'epoptes' has been added."
  fi
  usermod -aG epoptes "$user" >/dev/null || true
	mkdir -p /etc/epoptes/ >/dev/null|| true
	if ! [ -s /etc/epoptes/server.key ] || ! [ -s /etc/epoptes/server.crt ]; then
		faketime '1970-01-01 00:00:00 UTC' \
			openssl req -batch -x509 -nodes \
			-newkey rsa:4096 -days $(($(date --utc +%s) / 86400 + 3652)) \
			-keyout /etc/epoptes/server.key -out /etc/epoptes/server.crt
		chmod 600 /etc/epoptes/server.key
	fi
  ln -sf /etc/sv/epoptes /var/service/ >/dev/null || true
  log "A instalação foi concluída. Antes de utilizar o Epoptes, lembre-se de fazer o seguinte:"
  log "1.- Você deverá adicionar seu usuário ao grupo 'epoptes' - ${YELLOW}sudo usermod -aG epoptes $user"
  log "2.- Você deverá executar como root:"
  log "    ${YELLOW}'vservice enable epoptes' ${CYAN}para habilitar o serviço do servidor Epoptes."
  log "3.- Pode ser necessário reiniciar o sistema para que tudo funcione corretamente."
  log "4.- Se não quiser reiniciar o sistema, após realizar todos os passos acima, execute como root:"
  log "    ${YELLOW}'vservice start epoptes' ${CYAN}para iniciar o serviço do servidor Epoptes."
  log "Após concluir tudo isso, você ainda precisará encerrar a sessão e entrar novamente."
  log "Feito isso, o Epoptes deverá funcionar normalmente.${RESET}"
  log "Lembrete: o client-functions e lido so na inicializacao do epoptesd."
  log "Se voce ja tinha o Epoptes rodando antes de atualizar, reinicie o"
  log "serviço (${YELLOW}sudo vservice restart epoptes${CYAN}) para os clientes"
  log "passarem a receber as funções novas de suporte a Wayland."
}
pre_upgrade() {
	log "Iniciando upgrade"
}
post_upgrade() {
	log "Finalizando upgrade"
}
