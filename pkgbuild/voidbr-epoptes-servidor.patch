+    # VoidBR patch: selos de estado, dica e "Diagnosticar cliente".
+    @staticmethod
+    def session_desc(info):
+        """Return e.g. "Wayland - Hyprland" from the info of a connection."""
+        session = {'wayland': 'Wayland', 'x11': 'X11'}.get(
+            info.get('session', ''), '')
+        # XDG_CURRENT_DESKTOP pode ser uma lista, como "ubuntu:GNOME"
+        desktop = info.get('desktop', '').split(':')[-1]
+        return ' \u00b7 '.join([x for x in (session, desktop) if x])
+
+    def client_state(self, client, hsession=''):
+        """Return (level, text, hint) for an iconview entry.
+        level is 'warn' for a problem, 'info' otherwise."""
+        if hsession:
+            uname = client.users.get(hsession, {}).get('uname', '')
+            dups = len([1 for u in client.users.values()
+                        if u['uname'] == uname])
+            if dups > 1:
+                return ('warn', 'Sess\u00e3o duplicada \u00d7%d' % dups,
+                        'H\u00e1 %d conex\u00f5es de sess\u00e3o de %s. Mantenha '
+                        'a mais antiga e encerre as outras em Reconectar '
+                        'sess\u00e3o.' % (dups, uname))
+            if hsession in self.thumb_errors:
+                return ('warn', 'Miniatura falhou',
+                        'Motivo no cliente: %s' % self.thumb_errors[hsession])
+            if not client.hsystem:
+                return ('warn', 'Sem conex\u00e3o do root',
+                        'O servi\u00e7o epoptes-client da m\u00e1quina '
+                        'n\u00e3o est\u00e1 conectado: desligar, reiniciar e '
+                        'o terminal de root n\u00e3o funcionam. Use '
+                        'Diagnosticar cliente.')
+            return ('info', self.session_desc(
+                self.conn_info.get(hsession, {})), '')
+        if not client.hsystem:
+            return ('info', '', '')
+        connected = set(u['uname'] for u in client.users.values())
+        missing = [u for u in self.sys_gusers.get(client.hsystem, [])
+                   if u not in connected]
+        if missing:
+            return ('warn', 'Sess\u00e3o n\u00e3o conectou (%s)'
+                    % ', '.join(missing),
+                    'O usu\u00e1rio entrou, mas a conex\u00e3o da sess\u00e3o '
+                    'n\u00e3o veio: grupo epoptes, autostart ou certificado. '
+                    'Use Diagnosticar cliente.')
